# Copy this file to .env.local and fill in the values. Never commit .env.local.

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Secret. Server only. Never put this in client code.
SUPABASE_SERVICE_ROLE_KEY=

# The public address of the site (used in invite links). Leave blank locally.
NEXT_PUBLIC_SITE_URL=

# Optional: Resend (https://resend.com) for welcome emails.
# Without these, the admin screen shows the invite link to copy and send by hand.
RESEND_API_KEY=
EMAIL_FROM="Pocket Office <hello@yourdomain.com>"

# Sales workspace: use the EXISTING Stripe account and existing approved monthly prices.
# Leave sales payments disabled until preview approval, migration, webhook and test-mode verification.
SALES_PAYMENTS_ENABLED=false
SALES_STRIPE_ACCOUNT_ID=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_BASIC=
STRIPE_PRICE_PRO=
STRIPE_PRICE_PREMIUM=
STRIPE_PRICE_ULTIMATE=
# Optional dedicated 64-hex encryption key; existing OLIVERFEE_PREVIEW_SECRET is purpose-separated if used instead.
SALES_EMAIL_ENCRYPTION_KEY=

# Owner Admin Center notification encryption (server only; 64 hex characters).
OWNER_MANAGEMENT_EMAIL_KEY=
